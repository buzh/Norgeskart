{
        servers {
                metrics
        }
        admin :2019
}

:3000

route {
        header Strict-Transport-Security max-age=31536000
        header X-Content-Type-Options nosniff
        header Referrer-Policy strict-origin
        @allowedOrigins header_regexp Origin ^https://(kartkatalog\.)?geonorge\.no$
        header @allowedOrigins Access-Control-Allow-Origin {http.request.header.Origin}
        header Content-Security-Policy "
                default-src 'self';
                script-src 'self';
                worker-src 'self' blob:;
                img-src 'self' data: blob: tilecache.norgeibilder.no opencache.statkart.no *.geonorge.no *.norgeskart.no cache.kartverket.no *.kartverket-intern.cloud cache.atgcp1-prod.kartverket.cloud cache.atkv3-dev.kartverket.cloud data.kartverket.no *.ecc.no tnt-proxy.atkv3-dev.kartverket-intern.cloud tnt-proxy.atkv3-prod.kartverket.cloud *.maplytic.no *.ngu.no geodata.npolar.no;
                connect-src 'self' data: blob: tilecache.norgeibilder.no *.geonorge.no geonorge.no norgeskart.no *.norgeskart.no hoydedata.no cache.kartverket.no cache.atkv3-dev.kartverket.cloud opencache.statkart.no raw.githubusercontent.com *.ecc.no *.maplytic.no fonts.googleapis.com fonts.gstatic.com tnt-proxy.atkv3-dev.kartverket-intern.cloud tnt-proxy.atkv3-prod.kartverket.cloud geodata.npolar.no;
                style-src 'self' 'unsafe-inline' fonts.googleapis.com;
                font-src 'self' fonts.gstatic.com;
                frame-ancestors *;
        "
        header Permissions-Policy "geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), accelerometer=(), camera=()"
        
        handle /geoportal* {
                redir https://geonorge-nkg.atkv3-prod.kartverket.cloud/geoportal/?{query} permanent
                redir https://geonorge-nkg.atkv3-prod.kartverket.cloud/geoportal/ permanent
        }

        handle /api/styles/* {
                @options method OPTIONS
                handle @options {
                        header Access-Control-Allow-Origin "*"
                        header Access-Control-Allow-Methods "GET, OPTIONS"
                        header Access-Control-Allow-Headers "*"
                        respond 204
                }
                reverse_proxy https://dnl.kartverket.no {
                        header_up Host dnl.kartverket.no
                        header_down Access-Control-Allow-Origin "*"
                }
        }

        # Proxies to wmscache. One handler per upstream host — the second
        # path segment picks the host, the rest is passed through to that
        # host's WMS namespace. Layer configs use these same-origin paths
        # so no CSP whitelist entry is needed for the upstream and the
        # response can be cached by nginx.

        # wms.geonorge.no/skwms1/* — main Kartverket WMS namespace (theme
        # layers + national LiDAR + per-project LiDAR). handle_path strips
        # /wms/geonorge from the URI; the post-strip path already starts
        # with '/' so we prepend /skwms1 without another slash.
        handle_path /wms/geonorge/* {
                rewrite * /skwms1{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        # kart.ra.no/wms/* — Riksantikvaren Kulturminner WMS.
        handle_path /wms/ra/* {
                rewrite * /wms{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        # testapi.norgeskart.no/v1/* — matrikkel (cadastral) WMS.
        handle_path /wms/testapi/* {
                rewrite * /v1{http.request.uri.path}
                reverse_proxy http://wmscache
        }
}

root * /var/www
file_server
